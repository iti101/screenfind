# TMDB credentials — use either a v4 Read Access Token (JWT) or a v3 API Key
# Get yours at https://www.themoviedb.org/settings/api
VITE_TMDB_ACCESS_TOKEN=your_token_here

# NOVI Dynamic API
# Register at https://novi-backend-api-wgsgz.ondigitalocean.app/ and upload novi/screenfind-init.json
VITE_NOVI_BASE_URL=https://novi-backend-api-wgsgz.ondigitalocean.app/api
VITE_NOVI_PROJECT_ID=your_project_id_here
